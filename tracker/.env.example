# Cloudflare Access — the gate in front of the tracker.
#
# Leave CF_ACCESS_AUD unset and none of it runs: the tracker is open on the
# LAN, the Werkzeug debugger is on, and nothing has changed. Set both halves
# and every request must carry a token the app verifies itself, localhost and
# the phone on the home Wi-Fi included. See tracker/access.py.

# The <team>.cloudflareaccess.com you sign in at. No scheme.
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com

# The Application Audience (AUD) tag of the Access application that guards this
# hostname. Its own, NOT the wardrobe's: the audience check is what stops a
# valid token for another app in the same account opening this one.
CF_ACCESS_AUD=

# Who may in, comma-separated. Empty means nobody, deliberately.
CF_ACCESS_ALLOWED_EMAILS=maxime.boucoiran@gmail.com
